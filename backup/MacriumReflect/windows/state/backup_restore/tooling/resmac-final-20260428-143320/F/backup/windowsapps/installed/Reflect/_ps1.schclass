//=======================================================================
//================ Lex class support ====================================
//=======================================================================
// 	lexClass:
//		name       = c_CPPString
//		parent     = c_CPP
//		parent:dyn = c_CPP
//
//		children = 0
//		children = class1, class2, ...
//
//		previous:class          =	
//		previous:tag            =	
//		previous:tag:separators =	
//
//		start:class = 
//		start:Tag   = '"'
//
//		skip:Tag = '\"'
//
//		end:class      = //
//		end:Tag        = '"'
//		end:separators = ' '
//
//		Token:tag              = 'if', 'for', 'while', 'do'
//		Token:start:separators = 
//		Token:end:separators   = 
//-----------------------------------------------------------------------
//---------------- Attributes -------------------------------------------
//-----------------------------------------------------------------------
//	txt:colorFG = 0xffc0c0 // color value in hex format. default: black
//	txt:colorBK = 0xffc0c0 // color value in hex format. default: white
//
//	txt:colorSelFG = 0xffc0c0 // color value in hex format. default: white
//	txt:colorSelBK = 0xffc0c0 // color value in hex format. default: black
//
//	txt:Bold      = 1 // {1,0} default: 0
//	txt:italic    = 0 // {1,0} default: 0
//	txt:Underline = 1 // {1,0} default: 0
//
//	caseSensitive = 1 // {1,0} default: 0
//
//	Collapsable   = 1 // {1,0} default: 0
//	CollapsedText = '/*...*/' // quoted string value. default: '[..]'
//
//	ParseOnScreen = 0 // {1,0} default: 0
//-----------------------------------------------------------------------
//* Global attributes ***************************************************
//-----------------------------------------------------------------------
// 	global:FirstParseInSeparateThread	          = 0   // {0,1} default=1
// 	global:EditReparceInSeparateThread	        = 0   // {0,1} default=1
//	global:ConfigChangedReparceInSeparateThread = 0   // {0,1} default=1
// 	global:EditReparceTimeout_ms                = 500 // default= 500 ms; time out for start reparse after last key was pressed.
// 	global:MaxBackParseOffset                   = 100 // default= 100 chars; maximum back buffer size. Some times parser look back for the text from current position.
// 	global:OnScreenSchCacheLifeTime_sec         = 180 // default= 180 sec; -1 and 0 means infinite; time out for on screen parsed pices of text. for memory using optimization.
// 	global:ParserThreadIdleLifeTime_sec         = 60  // default=60 sec; -1 and 0 means infinite; time out for existing of parser thread when parser idle (no parse requests).
/////////////////////////////////////////////////////////////////////////
//=======================================================================
//================ Variables support ====================================
//=======================================================================
// NON operation - example:   @alpha:not
//
// @alpha	= a-z, A-Z
// @digit	= 0-9
// @HexDdigit	= 0-9, a-f, A-F
// @specs	= "~`!@#$%^&*()_-+=\\|{}[];:'\",.<>/?"
// @EOL		= End Of Line
//---------------------------------------------
// special tags:  '\\', '\'', '\t', '\r', '\n'
/////////////////////////////////////////////////////////////////////////

/// PowerShell ///
lexClass:
	parent:file   = <*.ps1>
	name          = c_PowerShellScript
	caseSensitive	= 0
	txt:colorFG   = 0x000000
	global:EditReparceTimeout_ms                = 15000
	global:OnScreenSchcacheLifeTime_sec         = 0
	global:ParserThreadIdleLifeTime_sec         = 300
 	global:FirstParseInSeparateThread           = 1 // {0,1} default=1
 	global:EditReparceInSeparateThread          = 1 // {0,1} default=1
	global:ConfigChangedReparceInSeparateThread = 1 // {0,1} default=1

lexClass: 	
	name          = c_PowerShellString_char
	parent:dyn    = c_PowerShellScript
	children		  = 0
	start:Tag		  = '"',  '\''
	end:Tag			  = '"',  '\'', @eol
	txt:colorFG		= 0xE00000
  
lexClass:
	name           = c_PowerShellComment
	parent         = c_PowerShellScript
	DisplayName    = 'PowerShell Comment'
	ParseOnScreen  = 0
	txt:colorFG	   = 0x008200
	txt:Italic	= 1
	end:separators = @EOL
	start:tag	     = '#'

lexClass:
	name          = c_PowerShellKeywords
	parent        = c_PowerShellScript
	DisplayName   = 'PowerShell Keywords'
	ParseOnScreen = 0
  txt:Bold      = 0
	txt:colorfg   = 0x0000FF
  token:tag     = 'begin'
  token:tag     = 'break'
  token:tag     = 'case'
  token:tag     = 'default'
  token:tag     = 'do'
  token:tag     = 'else'
  token:tag     = 'elseif'
  token:tag     = 'end'
  token:tag     = 'exit'
  token:tag     = 'filter'
  token:tag     = 'for'
  token:tag     = 'foreach'
  token:tag     = 'function'
  token:tag     = 'if'
  token:tag     = 'param'
  token:tag     = 'process'
  token:tag     = 'prompt'
  token:tag     = 'return'
  token:tag     = 'switch'
  token:tag     = 'then'
  token:tag     = 'throw'
  token:tag     = 'trap'
  token:tag     = 'until'
  token:tag     = 'while'
	token:start:separators	= ' ', '\t',    , '(', @eol
	token:end:separators	  = ' ', '\t', '(', ')', @eol, '.'
  
lexClass:
	name          = c_PowerShellTypes
	parent        = c_PowerShellScript
	DisplayName   = 'PowerShell Types'
	ParseOnScreen = 0
  txt:Bold      = 0
	txt:colorfg   = '0x0000FF
  token:tag     = 'array'
  token:tag     = 'bool'
  token:tag     = 'byte'
  token:tag     = 'char'
  token:tag     = 'decimal'
  token:tag     = 'double '
  token:tag     = 'hashtable'
  token:tag     = 'int'
  token:tag     = 'int32'
  token:tag     = 'long'
  token:tag     = 'single'
  token:tag     = 'string'
  token:tag     = 'void'
  token:tag     = 'xml'
	token:start:separators = ' ', '\t',    , '(', @eol
	token:end:separators   = ' ', '\t', '(', ')', @eol, '.'
  
